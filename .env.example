# LiveKit server (Cloud or self-hosted). Get these from your LiveKit project.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Single shared room for the whole world.
ROOM_NAME=voice-world

# Players who enter this code on the join screen get role=announcer in their
# token (and can use the PA mic). Leave empty to disable announcers entirely.
ANNOUNCER_CODE=change-me

# Token server port (Vite proxies /api to this in dev).
PORT=3001
