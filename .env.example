# LiveKit server (Cloud or self-hosted). Get these from your LiveKit project.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Single shared room for the whole world.
ROOM_NAME=voice-world

# Token server port (Vite proxies /api to this in dev).
PORT=3001

# Allow a front end hosted elsewhere (e.g. GitHub Pages) to fetch tokens (comma-separated origins)
# CORS_ORIGINS=https://sajithlaldev.github.io
